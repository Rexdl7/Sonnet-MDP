# ==============================================================================
# Sonnet Music Player - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# Never commit your actual .env file with private keys to version control.
# ==============================================================================

# Google Gemini AI API Key (Server-side)
# Used for AI-powered musical similarity recommendations and intelligent playlist generation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="your_gemini_api_key_here"

# Application Base URL
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Dynamic Firebase Client Configuration
# ------------------------------------------------------------------------------
# All client-side Firebase variables are prefixed with VITE_ to allow dynamic
# injection into the Vite bundle at runtime across any hosting platform
# (e.g., Vercel, Netlify, Cloudflare Pages, Firebase Hosting, AWS Amplify, Docker).
# ------------------------------------------------------------------------------

# Firebase Web API Key
VITE_FIREBASE_API_KEY="your_firebase_api_key_here"

# Firebase Auth Domain (e.g., your-project-id.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"

# Google Cloud / Firebase Project ID
VITE_FIREBASE_PROJECT_ID="your_project_id"

# Firestore Database ID (leave as '(default)' or specify your custom database ID)
VITE_FIREBASE_DATABASE_ID="your_firestore_database_id_here"

# Firebase Cloud Storage Bucket (e.g., your-project-id.firebasestorage.app)
VITE_FIREBASE_STORAGE_BUCKET="your_project_id.firebasestorage.app"

# Firebase Cloud Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id_here"

# Firebase Web App ID (e.g., 1:123456789012:web:abcdef1234567890abcdef)
VITE_FIREBASE_APP_ID="your_firebase_web_app_id_here"

# Firebase Measurement / Analytics ID (Optional)
VITE_FIREBASE_MEASUREMENT_ID="your_measurement_id_here"
